{
  "schemaVersion": 1,
  "resources": [
    {
      "id": "cargo",
      "path": ".artifacts/cargo-home/registry/cache",
      "validator": "cargo"
    },
    {
      "id": "swiftpm",
      "path": ".artifacts/swiftpm-cache",
      "validator": "swiftpm"
    },
    {
      "id": "bun",
      "path": ".artifacts/bun-cache",
      "validator": "bun",
      "includes": "Locked npm packages, including Ubuntu Mono font archives; installed node_modules and generated Vite assets remain worktree-local."
    },
    {
      "id": "jdtls",
      "path": ".artifacts/jdtls-downloads",
      "validator": "jdtls"
    },
    {
      "id": "jdk",
      "path": ".artifacts/jdk-downloads",
      "validator": "jdk"
    }
  ]
}
